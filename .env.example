# 环境变量配置模板
# 复制此文件为 .env.local 并填写实际值
# 命令: cp .env.example .env.local

# ==================== 应用配置 ====================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ==================== Supabase 配置 ====================
# 获取地址: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres.vadlhadksuzmdonnpfke
# 重要: 需要填写密码！从 Supabase Dashboard > Settings > Database 获取
SUPABASE_PASSWORD=
SUPABASE_URL=https://aws-0-ap-southeast-2.pooler.supabase.com:6543

# Supabase API Keys (从 Dashboard > Settings > API 获取)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# PostgreSQL 连接字符串 (Prisma 用，可选)
DATABASE_URL=postgresql://postgres.vadlhadksuzmdonnpfke:${SUPABASE_PASSWORD}@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# ==================== Redis 配置 ====================
# 外部 Redis 服务
REDIS_HOST=120.26.109.126
REDIS_PORT=6399
REDIS_PASSWORD=ipaking@545
REDIS_URL=redis://:${REDIS_PASSWORD}@120.26.109.126:6399

# ==================== JWT 配置 ====================
# 生产环境必须更换为强随机字符串 (建议 64 字符以上)
JWT_SECRET=smart-parking-jwt-secret-2024-dev-only

# ==================== CORS ====================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== 外部服务（可选） ====================
# 车牌识别 API（不配置则使用本地 OCR 降级）
LPR_API_URL=
LPR_API_KEY=

# 微信支付
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=

# 支付宝
ALIPAY_APP_ID=

# ==================== 文件存储（MinIO） ====================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=parking-images
